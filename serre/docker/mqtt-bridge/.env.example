# =============================================================================
#  .env.example  –  Copy to .env and fill in real values
#  Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (external MySQL / MariaDB server)
# ---------------------------------------------------------------------------
DB_HOST=your-db-host-or-ip
DB_PORT=3306
DB_NAME=parc
DB_USER=parc_user
DB_PASSWORD=change_me_strong_password

# ---------------------------------------------------------------------------
# MQTT broker (optional auth – leave blank for anonymous)
# ---------------------------------------------------------------------------
MQTT_USER=
MQTT_PASSWORD=

# Expose Mosquitto port on the host (useful for external devices / debugging)
MQTT_EXPOSE_PORT=1883

# ---------------------------------------------------------------------------
# Bridge behaviour
# ---------------------------------------------------------------------------
# Seconds to wait between DB / MQTT reconnection attempts
DB_RETRY_DELAY=5
MQTT_RETRY_DELAY=5

# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
